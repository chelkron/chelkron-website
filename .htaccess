# chelkron.com on cPanel (Apache)
Options -Indexes
DirectoryIndex index.php index.html
# The pages (/workforce, /pricing, /terms …) are served by the rewrite below, so Apache mustn't first redirect them to a trailing slash
DirectorySlash Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Always HTTPS, and no "www."
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^ https://chelkron.com%{REQUEST_URI} [R=301,L]

    # Pages at clean addresses (/workforce, /pricing, /terms …) without a trailing-slash redirect
    RewriteRule ^(workforce|mail|pricing|about|contact|terms|privacy-policy)/?$ $1/index.php [L]
    # Blog: the list, the RSS feed, and each post at /blog/<address> (inc/blog.php)
    RewriteRule ^blog/?$ blog/index.php [L]
    RewriteRule ^blog/feed\.xml$ blog/feed.php [L]
    RewriteRule ^blog/([a-z0-9-]+)/?$ blog/post.php?slug=$1 [L,QSA]
    # Old addresses
    RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

# Never serve the repo's own files or the page parts in /inc
<FilesMatch "^(README\.md|\.git.*)$">
    Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
RedirectMatch 404 ^/inc(/|$)
# Posts are read through /blog/<address>, not as raw files
RedirectMatch 404 ^/blog/posts(/|$)

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "\.(css|js|svg|png)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>
